# ==============================================================================
# 前后端对外共用单一端口（默认 3000），所有 /api 请求由前端服务内置自动转发至后端。
# 外部反向代理仅需将根路径反代至对外端口即可，无需为 /api 编写额外路由规则。
# ==============================================================================

# 浏览器访问来源；生产环境必须使用 HTTPS，不能包含末尾斜杠。
LAULL_HOME_ORIGIN=http://localhost:3000
# 数据库路径相对仓库根目录解析，也支持绝对路径。
LAULL_HOME_DATABASE_PATH=data/laull-home.db
# 数据持久化根目录，用于存储壁纸与图标等静态资源。
LAULL_HOME_DATA_DIR=data
# Session 固定有效期，范围为 1 至 365 天。
LAULL_HOME_SESSION_DAYS=90

# --- 内部通信配置（默认自动推导，通常无需配置）---
# 后端内部监听主机，默认 127.0.0.1。
# LAULL_HOME_HOST=127.0.0.1
# 后端内部通信端口，默认 3001。
# LAULL_HOME_PORT=3001
# Nuxt 内部 API 地址，默认根据上述主机与端口自动拼接，无需手动配置。
# NUXT_API_INTERNAL_URL=http://127.0.0.1:3001


# --- Docker 部署配置（配合 compose.yml 使用）---
# 宿主机对外暴露的访问端口，默认 3000。
APP_PORT=3000
# 宿主机绑定地址，配合本机反代时可设为 127.0.0.1，默认 0.0.0.0。
APP_HOST=0.0.0.0
# 宿主机持久化数据挂载路径，默认挂载当前目录下的 ./data。
DATA_PATH=./data

